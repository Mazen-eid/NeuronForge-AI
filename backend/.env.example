# Copy to `.env` and fill in what you actually have.
# Everything here is optional — the pipeline runs in dry-run mode without any keys.

# ---- LLM provider (pick ONE) ----
# "mock" (default, no key), "groq", "openai", "ollama"
LLM_PROVIDER=mock

# Groq is the recommended free option: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (paid): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (fully local & free, requires a GPU/CPU with the model pulled): https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Stock media (both free with signup) ----
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ---- API server ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]
